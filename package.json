{
  "name": "front-rostroperfecto",
  "version": "0.3.0",
  "description": "Sitio de fidelizacion y turnos de Rostro Perfecto (React + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "npm run build && cp dist/index.html dist/404.html",
    "build:local": "tsc --noEmit && VITE_API_BASE_URL=http://localhost:8082 vite build",
    "preview": "vite preview --port 5173",
    "audit": "npm audit --audit-level=critical",
    "gen:api": "openapi-typescript ../backend/docs/openapi.yaml -o src/libreria/api/esquema.d.ts"
  },
  "type": "module",
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  },
  "private": true
}
